#!/bin/bash
# Post-install script for MCPanel .deb package.
# Installs mcpanel-cli from the latest GitHub release if not already present.

set -e

GITHUB_REPO="DippyCoder/mcpanel-cli"
GITHUB_API="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"

# Fetch the latest release tag from GitHub API.
# Falls back silently to empty string if curl/wget aren't available or API fails.
get_latest_tag() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$GITHUB_API" 2>/dev/null \
            | grep '"tag_name"' | head -1 \
            | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/'
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "$GITHUB_API" 2>/dev/null \
            | grep '"tag_name"' | head -1 \
            | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/'
    fi
}

install_cli() {
    local tag
    tag=$(get_latest_tag)

    local url
    if [ -n "$tag" ]; then
        url="git+https://github.com/${GITHUB_REPO}.git@${tag}"
    else
        # API unreachable — fall back to HEAD of the default branch
        url="git+https://github.com/${GITHUB_REPO}.git"
    fi

    if command -v pip3 >/dev/null 2>&1; then
        pip3 install --user "$url" >/dev/null 2>&1 && return 0
    fi
    if command -v pip >/dev/null 2>&1; then
        pip install --user "$url" >/dev/null 2>&1 && return 0
    fi
    return 1
}

if ! command -v mcpanel >/dev/null 2>&1; then
    install_cli || true
fi

exit 0
