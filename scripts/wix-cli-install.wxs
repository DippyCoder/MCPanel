<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX fragment: install mcpanel-cli after MSI installation.
  win-install-cli.ps1 is bundled as a resource (bundle.resources in tauri.conf.json)
  and lands in INSTALLDIR, where this CA picks it up.
  Deferred + Impersonate="yes" = runs as the installing user (correct %APPDATA% for
  pip --user) while still holding the admin token needed to write the machine PATH.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <CustomAction
      Id='InstallMCPanelCLI'
      Directory='INSTALLDIR'
      Execute='deferred'
      Impersonate='yes'
      Return='ignore'
      ExeCommand='powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File win-install-cli.ps1'
    />
    <InstallExecuteSequence>
      <!-- Run after files are written to disk, on install and upgrade but not uninstall -->
      <Custom Action='InstallMCPanelCLI' After='InstallFiles'>NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
