{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPanel",
  "version": "2.1.2",
  "identifier": "com.dippycoder.mcpanel",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MCPanel",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["python3", "python3-pip", "libwebkit2gtk-4.1-0", "libssl3", "libgtk-3-0"],
        "desktopTemplate": "mcpanel.desktop"
      },
      "rpm": {
        "depends": ["python3", "webkit2gtk4.1", "openssl-libs", "gtk3"],
        "desktopTemplate": "mcpanel.desktop",
        "postInstallScript": "../scripts/rpm-postinst"
      }
    },
    "shortDescription": "Minecraft Server Panel",
    "resources": {
      "../scripts/win-install-cli.ps1": "win-install-cli.ps1"
    },
    "windows": {
      "wix": {
        "fragmentPaths": ["wix-cli-install.wxs"]
      },
      "nsis": {
        "installerHooks": "../scripts/win-install-nsis.nsh"
      }
    }
  }
}
